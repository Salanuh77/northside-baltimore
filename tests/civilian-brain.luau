local Brain=require('../src/CivilianBrain')
local function step(s,t,i) i=i or {};i.health=i.health or 100;return Brain.step(s,t,i) end
local s=Brain.new('bold',0)
assert(step(s,0).mode=='Walking')
assert(step(s,1,{crowded=true}).mode=='Yielding','Passersby should yield instead of clipping through people')
assert(step(s,2,{talk=true}).mode=='Talking','Peaceful conversation pauses the route')
Brain.notice(s,3,{kind='gunfire',position='corner'})
assert(step(s,3).mode=='Fleeing','Heard shot interrupts conversation')
assert(s.threat.suspect==nil,'Hearing cannot identify a hidden shooter')
assert(not step(s,6,{safeDistance=true}).report,'Unidentified noises do not accuse a player')
assert(step(s,30).mode=='Recovering','Expired danger has a recovery transition')
assert(step(s,34).mode=='Walking','Routine resumes after recovery')
local bold=Brain.new('bold',0)
Brain.notice(bold,1,{kind='assault',position='attacker',suspect=42,seen=true,victim=true})
assert(step(bold,1,{visibleThreat=true,distance=3}).mode=='Defending','Bold assault victim can fight back')
assert(step(bold,2,{visibleThreat=true,distance=3,armed=true}).mode=='Fleeing','Civilian does not box a gunman')
assert(step(bold,3,{visibleThreat=true,distance=40}).mode~='Defending','No unlimited pursuit')
local timid=Brain.new('cautious',0)
Brain.notice(timid,0,{kind='assault',position='corner',suspect=8,seen=true})
assert(step(timid,0,{visibleThreat=true,distance=3}).mode=='Fleeing','Personalities choose different responses')
assert(step(timid,4,{safeDistance=true}).mode=='Reporting')
assert(step(timid,7,{safeDistance=true}).report.suspect==8,'Witness reports the known suspect after a safe call')
assert(not step(timid,8,{safeDistance=true}).report,'One report per incident')
local wary=Brain.new('sociable',0)
Brain.notice(wary,1,{kind='weapon',position='door',suspect=2,seen=true})
assert(step(wary,1,{distance=12,visibleThreat=true,armed=true}).mode=='Wary')
assert(step(wary,1.5,{distance=3,visibleThreat=true,armed=true}).mode=='Fleeing')
assert(step(wary,2,{ragdoll=true}).mode=='Knocked down')
assert(Brain.step(wary,3,{health=0}).mode=='Dead')
local interrupted=Brain.new('cautious',0)
Brain.notice(interrupted,0,{kind='assault',position='corner',suspect=4,seen=true})
step(interrupted,1,{safeDistance=true})
step(interrupted,2,{ragdoll=true})
assert(not step(interrupted,4,{safeDistance=true}).report,'An interrupted witness call restarts its safe interval')
assert(step(interrupted,7,{safeDistance=true}).report,'Uninterrupted resumed call completes')
local witness=Brain.new('bold',0)
Brain.notice(witness,0,{kind='assault',position='corner',suspect=42,seen=true,victim=false})
assert(step(witness,1,{visibleThreat=true,distance=3}).mode=='Fleeing','Bystanders do not join somebody else\'s fist fight')
print('PASS: civilian routines, interruptions, evidence memory, personalities, bounded defense and witness calls')
