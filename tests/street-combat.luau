local Rules=require('../src/StreetCombatRules')
local s=Rules.new(0)
local a=assert(Rules.attack(s,0))
assert(a.combo==1 and a.damage>0 and a.windup>0,'First punch telegraphs its hit')
assert(not Rules.attack(s,.01),'Spam cannot skip recovery')
assert(not Rules.guard(s,.1,true),'No attacking and blocking together')
assert(Rules.attack(s,.65).combo==2,'Second deliberate punch chains')
assert(Rules.attack(s,1.3).combo==3,'Third punch is a finisher')
assert(not Rules.attack(s,1.4),'Finisher has recovery')
assert(Rules.attack(s,2.5).combo==1,'Finisher resets the combo')
assert(Rules.attack(Rules.new(0),8).combo==1,'Idle starts a fresh chain')
local guard=Rules.new(0);assert(Rules.guard(guard,0,true))
local blocked=Rules.hit(guard,.1,12,true,false)
assert(blocked.blocked and blocked.damage<12 and not blocked.knockdown,'Frontal guard reduces damage')
local rear=Rules.hit(guard,.2,12,false,false)
assert(not rear.blocked and rear.damage==12,'Rear hits bypass guard')
assert(not Rules.attack(guard,.25),'Hit stun interrupts retaliation')
local tired=Rules.new(0);tired.stamina=2;Rules.guard(tired,0,true)
assert(Rules.hit(tired,.1,20,true,true).broken,'Exhausted guard breaks')
assert(not Rules.guard(tired,.2,true),'Broken guard cannot immediately restart')
local down=Rules.new(0);assert(Rules.hit(down,0,18,false,true).knockdown)
assert(not Rules.attack(down,1),'Knocked-down character cannot punch')
assert(Rules.attack(down,3),'Recovery restores fighting')
local elapsed=Rules.new(0);Rules.guard(elapsed,0,true);Rules.update(elapsed,30)
assert(elapsed.stamina>=0 and elapsed.stamina<=100,'Guard drain stays bounded')
local spent=Rules.new(0);spent.stamina=0;assert(not Rules.attack(spent,0))
Rules.update(spent,10);assert(spent.stamina==100,'Idle stamina regenerates')
print('PASS: timed combos, recovery, guard direction, guard break, stun, knockdown and stamina')
