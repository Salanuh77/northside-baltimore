local Pose=require('../src/CombatPose')
local guard=Pose.sample('Blocking',1,0)
assert(guard.LeftShoulder[1]>1 and guard.RightShoulder[1]>1,'Both forearms cover the head')
local jab=Pose.sample('Attacking',1,.18)
local cross=Pose.sample('Attacking',2,.22)
local hook=Pose.sample('Attacking',3,.3)
assert(jab.LeftElbow[1]<.1 and cross.RightElbow[1]<.1,'Jab and cross extend alternate arms')
assert(math.abs(hook.RightShoulder[2])>.5,'Finisher has a different hook arc')
assert(Pose.sample('Attacking',1,.55).LeftElbow[1]>1,'Arm retracts during recovery')
assert(next(Pose.sample('Idle',1,4))==nil,'Idle releases the pose')
assert(Pose.sample('Idle',1,0,'Cowering').Waist[1]>0,'Civilian fear has a visible body pose')
assert(Pose.sample('Idle',1,0,'Reporting').RightElbow[1]>1,'Witness call lifts a hand')
print('PASS: visible guard, alternating punches, hook, recovery and civilian gestures')
