local Inventory=require('../src/WeaponInventory')
local Catalog=require('../src/WeaponCatalog')
local function fresh(cash) local d={Cash=cash or 500,Items={},Stock={},Magazine=0};Inventory.restore(d);return d end
local d=fresh()
assert(Inventory.buy(d,'Compact') and d.Cash==250 and d.Magazine==12,'Starter cash can buy a loaded sidearm')
d.Magazine=3;assert(Inventory.buy(d,'Compact') and d.Cash==250 and d.Magazine==3,'Owned selection never recharges or refills')
assert(not Inventory.buy(d,'Carbine') and d.Cash==250,'Cash cannot mint premium guns')
assert(not Inventory.buy(d,'SMG') and d.Cash==250,'Insufficient cash is unchanged')
assert(not Inventory.buy(d,'unknown'),'Reject unknown catalog keys')
d.Cash=1000;assert(Inventory.buy(d,'SMG') and d.Magazine==24)
d.Magazine=4;Inventory.select(d,'Compact');assert(d.Magazine==3)
Inventory.select(d,'SMG');assert(d.Magazine==4,'Loadout swapping preserves each magazine')
assert(Inventory.attachment(d,'Suppressor') and d.Cash==30 and Inventory.active(d,'Suppressor'))
assert(Inventory.attachment(d,'Suppressor') and not Inventory.active(d,'Suppressor') and d.Cash==30)
assert(not Inventory.attachment(d,'Scope') and d.Cash==30)
d.Cash=1000;Inventory.buy(d,'Shotgun');assert(not Inventory.attachment(d,'Suppressor'),'Reject unsupported muzzle')
Inventory.add(d,'Carbine',12);Inventory.select(d,'Carbine');d.Magazine=5
assert(Inventory.buy(d,'Carbine') and d.Magazine==5,'An owned premium gun can be re-equipped from the cash loadout')
Inventory.add(d,'Carbine',12);assert(d.Magazine==5,'Extra premium copy cannot refill equipped ammo')
assert(Inventory.remove(d,'Carbine')==5 and d.Guns.Carbine==1 and d.GunMags.Carbine==0,'Trade removes copy and its loaded rounds')
assert(Inventory.returnCopy(d,'Carbine',5) and d.Guns.Carbine==2 and d.GunMags.Carbine==5,'Failed trade returns the original loaded rounds even when another copy exists')
local legacy={Items={Pistol=true},Stock={Sidearm=2},Magazine=7};Inventory.restore(legacy)
assert(legacy.Weapon=='Carbine' and legacy.Guns.Carbine==2 and legacy.Magazine==7,'Paid legacy purchases migrate')
local restored=fresh();Inventory.capture(d);Inventory.restore(restored,d)
assert(restored.Guns.SMG==1 and restored.GunMags.SMG==4 and restored.Attachments.Suppressor,'Saved armory restores')
local bad=fresh();Inventory.restore(bad,{Guns={Compact=0/0,SMG=-2,Carbine=math.huge},GunMags={Carbine=math.huge},Weapon='invalid'})
assert(not bad.Guns.Compact and not bad.Guns.SMG and bad.Guns.Carbine==100 and bad.Magazine==12)
assert(Catalog.hearing(true)<Catalog.hearing(false) and Catalog.hearing(true)>0)
print('PASS cash armory, premium boundary, save migration, magazine conservation, trading and attachment compatibility')
